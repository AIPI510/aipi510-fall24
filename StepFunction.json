{
  "Comment": "ETL Pipeline",
  "StartAt": "Extract",
  "States": {
    "Extract": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-2:886436924001:function:ExtractFunction",
      "Next": "Transform",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HandleFailure"
        }
      ]
    },
    "Transform": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-2:886436924001:function:TransformFunction",
      "Next": "Load",
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HandleFailure"
        }
      ]
    },
    "Load": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-2:886436924001:function:LoadFunction",
      "End": true,
      "Retry": [
        {
          "ErrorEquals": [
            "States.TaskFailed"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "HandleFailure"
        }
      ]
    },
    "HandleFailure": {
      "Type": "Fail",
      "Error": "ETLFailure",
      "Cause": "ETL Pipeline failed"
    }
  }
}
